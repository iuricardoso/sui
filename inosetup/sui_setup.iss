#define MyAppName "Simplex User Interface"
#define MyAppVersion "0.5"
#define MyAppURL "https://iuricardoso.github.io/research/sui/"
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{F64E9F97-2FCA-4301-8701-874CD5C131CC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={userappdata}\CodeBlocks\UserTemplates\SUI-v0.5
DisableDirPage=yes
DefaultGroupName=SUI-v0.5
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
OutputDir=G:\Meu Drive\2. Pesquisa\2026\Fluxo Contínuo\Versões\OOSUI
OutputBaseFilename=suisetup
SolidCompression=yes
WizardStyle=modern stellar
UsePreviousAppDir=no
Uninstallable=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

